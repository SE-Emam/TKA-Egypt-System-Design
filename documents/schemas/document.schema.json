{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "TKA Document Content Contract",
  "type": "object",
  "additionalProperties": false,
  "required": ["title", "language", "direction", "profile", "sections"],
  "properties": {
    "title": {"type": "string", "minLength": 1},
    "description": {"type": "string"},
    "language": {"type": "string", "minLength": 2},
    "direction": {"enum": ["ltr", "rtl"]},
    "profile": {"type": "string", "minLength": 1},
    "sections": {"type": "array", "minItems": 1, "items": {"type": "object", "required": ["heading", "paragraphs"], "properties": {"heading": {"type": "string", "minLength": 1}, "paragraphs": {"type": "array", "items": {"type": "string"}}, "code": {"type": "string"}}}}
  }
}
