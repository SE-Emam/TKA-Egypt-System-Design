{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "TKA Document Content Contract",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "title",
    "language",
    "direction",
    "profile",
    "sections"
  ],
  "properties": {
    "title": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string"
    },
    "language": {
      "type": "string",
      "minLength": 2
    },
    "direction": {
      "enum": [
        "ltr",
        "rtl"
      ]
    },
    "profile": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "sections": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "heading"
        ],
        "properties": {
          "heading": {
            "type": "string",
            "minLength": 1
          },
          "paragraphs": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "bullets": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "code": {
            "type": "string"
          },
          "table": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "headers",
              "rows"
            ],
            "properties": {
              "headers": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "string"
                }
              },
              "rows": {
                "type": "array",
                "items": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                }
              }
            }
          }
        },
        "anyOf": [
          {
            "required": [
              "paragraphs"
            ]
          },
          {
            "required": [
              "bullets"
            ]
          },
          {
            "required": [
              "code"
            ]
          },
          {
            "required": [
              "table"
            ]
          }
        ]
      }
    }
  }
}
