<!doctype html>
<html lang="{{language}}" dir="{{direction}}">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{{title}}</title>
<style>
:root {
  /* Token adapter must inject values from panda.config.ts; no local hex palette. */
  --tka-brand-blue: var(--tka-token-brand-500);
  --tka-brand-yellow: var(--tka-token-accent-500);
  --tka-document-foreground: var(--tka-token-neutral-800);
  --tka-document-background: var(--tka-token-neutral-0);
}
html { color: var(--tka-document-foreground); background: var(--tka-document-background); }
body { margin: 0 auto; max-width: 52rem; padding: 2.5rem; font-family: "Readex Pro", "Segoe UI", sans-serif; line-height: 1.8; }
h1, h2 { line-height: 1.35; }
h1 { border-block-end: 4px solid var(--tka-brand-blue); padding-block-end: .75rem; }
a { color: var(--tka-brand-blue); }
.accent { border-inline-start: 4px solid var(--tka-brand-yellow); padding-inline-start: 1rem; }
@media print { body { max-width: none; padding: 0; } }
</style>
</head>
<body><main><h1>{{title}}</h1>{{description}} {{#each sections}}<section><h2>{{heading}}</h2>{{#each paragraphs}}<p>{{this}}</p>{{/each}}</section>{{/each}}</main></body>
</html>
